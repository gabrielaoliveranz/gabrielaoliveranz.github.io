# Normalises every text file to LF in the git object database, regardless
# of what line endings a contributor's OS/editor/git config writes to
# disk locally. See CLAUDE.md, "Line endings are the repo's problem, not
# core.autocrlf's".
* text=auto eol=lf

# True binaries — never text-normalise these, regardless of extension
# detection.
*.woff2 binary
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
